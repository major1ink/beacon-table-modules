          "color": "#c9a24a"
        },
        {
          "value": "архетип",
          "label": "Архетип",
          "glyph": "sword",
          "color": "#c9a24a"
        },
        {
          "value": "вид",
          "label": "Вид",
          "glyph": "feather",
          "color": "#3fb950"
        },
        {
          "value": "черта вида",
          "label": "Черта вида",
          "glyph": "feather",
          "color": "#3fb950"
        },
        {
          "value": "происхождение",
          "label": "Происхождение",
          "glyph": "scroll",
          "color": "#a371f7"
        },
        {
          "value": "черта",
          "label": "Черта",
          "glyph": "sparkle",
          "color": "#4a8ef0"
