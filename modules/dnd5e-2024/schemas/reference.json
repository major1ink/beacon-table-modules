  "list": {
    "subtitle": "{kind} · {parent}",
    "group": "kind",
    "sort": [
      "kind",
      "name"
    ],
    "filters": [
      "kind",
      "parent",
      "tags"
    ],
    "search": [
      "name",
      "kind",
      "parent",
      "source",
      "tags"
    ],
    "medallion": {
      "field": "kind",
      "glyph": "scroll"
    },
    "categories": {
      "field": "kind",
      "other": "Черты",
      "rules": [
        {
          "label": "Классы",
          "equals": [
            "класс",
            "архетип"
          ]
        },
        {
          "label": "Виды",
          "equals": [
            "вид"
          ]
        },
        {
          "label": "Предыстории",
          "equals": [
            "происхождение"
          ]
        }
      ]
    }
  }
