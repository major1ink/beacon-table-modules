    "size": {
      "type": "text",
      "path": "size",
      "label": "Размер",
      "placeholder": "Средний"
    },
    "carry": {
      "type": "computed",
      "label": "Грузоподъёмность (фунт.)",
      "formula": "@str * 15"
    },
    "jump_high": {
      "type": "computed",
      "label": "Прыжок в высоту (фут.)",
      "formula": "3 + @str_mod"
    },
    "jump_long": {
      "type": "computed",
      "label": "Прыжок в длину (фут.)",
      "formula": "@str"
    },
    "attunement": {
      "type": "table",
      "path": "attunementItems",
      "label": "Настройка на магические предметы",
      "columns": [
        {
          "id": "name",
          "type": "text",
          "path": "name",
          "label": "Предмет"
        },
        {
          "id": "attuned",
          "type": "bool",
          "path": "attuned",
          "label": "Настроен"
        }
      ]
    }
  },
  "layout": [
    {
      "widget": "hp",
      "column": 1,
      "mode": "view"
    },
    {
      "widget": "xp",
