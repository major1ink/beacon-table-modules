    },
    "note_5": {
      "type": "longtext",
      "path": "notes.5",
      "label": "Заметки 6"
    },
    "age": {
      "type": "text",
      "path": "physical.age",
      "label": "Возраст"
    },
    "height": {
      "type": "text",
      "path": "physical.height",
      "label": "Рост"
    },
    "weight": {
      "type": "text",
      "path": "physical.weight",
      "label": "Вес"
    },
    "eyes": {
      "type": "text",
      "path": "physical.eyes",
      "label": "Глаза"
    },
    "skin": {
      "type": "text",
      "path": "physical.skin",
      "label": "Кожа"
    },
    "hair": {
      "type": "text",
      "path": "physical.hair",
      "label": "Волосы"
    },
    "spell_ability": {
      "type": "select",
      "path": "spellcasting.ability",
      "label": "Характеристика",
      "options": [
        {
          "value": "int",
          "label": "Интеллект",
          "formula": "@int_mod"
        },
        {
          "value": "wis",
          "label": "Мудрость",
          "formula": "@wis_mod"
        },
        {
          "value": "cha",
          "label": "Харизма",
          "formula": "@cha_mod"
        }
      ]
    },
    "spell_mod": {
      "type": "computed",
      "label": "Модификатор",
      "formula": "@spell_ability",
      "signed": true
    },
    "spell_dc": {
      "type": "computed",
      "label": "СЛ спасброска",
      "formula": "8 + @prof + @spell_ability"
    },
    "spell_attack": {
      "type": "computed",
      "label": "Бонус атаки",
      "formula": "@prof + @spell_ability",
      "signed": true
    },
    "slots": {
      "type": "table",
      "path": "spellcasting.slotsByLevel",
      "label": "Ячейки заклинаний",
