{
  "format": "beacon-schema/v1",
  "kind": "sheet",
  "core": {
    "hp.current": "hp_current",
    "hp.max": "hp_max",
    "ac": "ac",
    "speed": "speed",
    "initiative": "initiative"
  },
  "fields": {
    "player": {
      "type": "text",
      "path": "info.playerName",
      "label": "Имя игрока"
    },
    "info_bg": {
      "type": "text",
      "path": "info.background",
      "label": "Предыстория",
      "suggest": {
        "reference": "происхождение"
      }
    },
    "class": {
      "type": "text",
      "path": "info.class",
      "label": "Класс",
      "suggest": {
        "reference": "класс"
      }
    },
    "subclass": {
      "type": "text",
      "path": "info.subclass",
      "label": "Подкласс",
      "suggest": {
        "reference": "архетип",
        "parentField": "class"
      }
    },
    "race": {
      "type": "text",
      "path": "info.race",
      "label": "Раса",
      "suggest": {
        "reference": "вид"
      }
    },
    "level": {
      "type": "number",
      "path": "info.level",
      "label": "Уровень",
      "default": 1
    },
    "xp": {
      "type": "number",
      "path": "info.xp",
      "label": "Опыт"
    },
    "alignment": {
      "type": "text",
      "path": "alignment",
      "label": "Мировоззрение"
    },
    "prof": {
      "type": "computed",
      "label": "Бонус владения",
      "formula": "2 + floor((min(max(@level, 1), 20) - 1) / 4)",
      "signed": true
    },
    "str": {
      "type": "number",
      "path": "abilities.str",
      "label": "Сила",
      "short": "Сил",
      "modifierTarget": "abilities.str",
      "default": 10
    },
    "str_mod": {
      "type": "computed",
      "label": "Проверка: Сила",
      "formula": "floor((@str - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @str_mod"
    },
    "dex": {
      "type": "number",
      "path": "abilities.dex",
      "label": "Ловкость",
      "short": "Лов",
      "modifierTarget": "abilities.dex",
      "default": 10
    },
    "dex_mod": {
      "type": "computed",
      "label": "Проверка: Ловкость",
      "formula": "floor((@dex - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @dex_mod"
    },
    "con": {
      "type": "number",
      "path": "abilities.con",
      "label": "Телосложение",
      "short": "Тел",
      "modifierTarget": "abilities.con",
      "default": 10
    },
    "con_mod": {
      "type": "computed",
      "label": "Проверка: Телосложение",
      "formula": "floor((@con - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @con_mod"
    },
    "int": {
      "type": "number",
      "path": "abilities.int",
      "label": "Интеллект",
      "short": "Инт",
      "modifierTarget": "abilities.int",
      "default": 10
    },
    "int_mod": {
      "type": "computed",
      "label": "Проверка: Интеллект",
      "formula": "floor((@int - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @int_mod"
    },
    "wis": {
      "type": "number",
      "path": "abilities.wis",
      "label": "Мудрость",
      "short": "Мдр",
      "modifierTarget": "abilities.wis",
      "default": 10
    },
    "wis_mod": {
      "type": "computed",
      "label": "Проверка: Мудрость",
      "formula": "floor((@wis - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @wis_mod"
    },
    "cha": {
      "type": "number",
      "path": "abilities.cha",
      "label": "Харизма",
      "short": "Хар",
      "modifierTarget": "abilities.cha",
      "default": 10
    },
    "cha_mod": {
      "type": "computed",
      "label": "Проверка: Харизма",
      "formula": "floor((@cha - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @cha_mod"
    },
    "hp_current": {
      "type": "number",
      "path": "combat.hpCurrent",
      "label": "Хиты сейчас"
    },
    "hp_max": {
      "type": "number",
      "path": "combat.hpMax",
      "label": "Хиты макс.",
      "modifierTarget": "hp.max"
    },
    "hp_temp": {
      "type": "number",
      "path": "combat.hpTemp",
      "label": "Врем. хиты"
    },
    "ac": {
      "type": "number",
      "path": "combat.ac",
      "label": "КЗ",
      "modifierTarget": "ac"
    },
    "speed": {
      "type": "number",
      "path": "combat.speed",
      "label": "Скорость",
      "modifierTarget": "speed"
    },
    "darkvision": {
      "type": "number",
      "path": "combat.darkvision",
      "label": "Тёмное зрение"
    },
    "initiative": {
      "type": "computed",
      "label": "Инициатива",
      "formula": "@dex_mod",
      "signed": true,
      "roll": "1d20 + @dex_mod"
    },
    "passive": {
      "type": "computed",
      "label": "Пасс. восприятие",
      "formula": "10 + @wis_mod + @skillProf.perception * @prof"
    },
    "hit_total": {
      "type": "text",
      "path": "combat.hitDiceTotal",
      "label": "Кости хитов (всего)",
      "placeholder": "3к8"
    },
    "hit_current": {
      "type": "text",
      "path": "combat.hitDiceCurrent",
      "label": "Кости хитов (сейчас)",
      "placeholder": "3к8"
    },
    "death_ok": {
      "type": "tally",
      "path": "combat.deathSaveSuccess",
      "label": "Спасбр. от смерти — успехи",
      "max": 3
    },
    "death_fail": {
      "type": "tally",
      "path": "combat.deathSaveFail",
      "label": "Спасбр. от смерти — провалы",
      "max": 3,
      "tone": "bad"
    },
    "exhaustion": {
      "type": "tally",
      "path": "combat.exhaustion",
      "label": "Истощение",
      "max": 6,
      "tone": "bad"
    },
    "inspiration": {
      "type": "bool",
      "path": "combat.inspiration",
      "label": "Героическое вдохновение"
    },
    "dying": {
      "type": "bool",
      "path": "combat.isDying",
      "label": "Умирает / без сознания"
    },
    "conditions": {
      "type": "longtext",
      "path": "combat.conditions",
      "label": "Состояния (заметка)"
    },
    "armor_light": {
      "type": "bool",
      "path": "armor.lightArmor",
      "label": "Лёгкие доспехи"
    },
    "armor_medium": {
      "type": "bool",
      "path": "armor.mediumArmor",
      "label": "Средние доспехи"
    },
    "armor_heavy": {
      "type": "bool",
      "path": "armor.heavyArmor",
      "label": "Тяжёлые доспехи"
    },
    "armor_shield": {
      "type": "bool",
      "path": "armor.shield",
      "label": "Щит"
    },
    "weapons_simple": {
      "type": "bool",
      "path": "armor.simpleWeapons",
      "label": "Простое оружие"
    },
    "weapons_martial": {
      "type": "bool",
      "path": "armor.martialWeapons",
      "label": "Воинское оружие"
    },
    "weapons_other": {
      "type": "text",
      "path": "armor.otherWeapons",
      "label": "Другое оружие"
    },
    "tools": {
      "type": "longtext",
      "path": "toolsLanguages",
      "label": "Владение инструментами и языками"
    },
    "prof_notes": {
      "type": "longtext",
      "path": "proficiencyNotes",
      "label": "Прочие владения (текстом)"
    },
    "saves": {
      "type": "table",
      "path": "saveProf",
      "label": "Спасброски",
      "rows": [
        {
          "key": "str",
          "label": "Сила (спасбросок)",
          "formulas": {
            "base": "@str_mod"
          }
        },
        {
          "key": "dex",
          "label": "Ловкость (спасбросок)",
          "formulas": {
            "base": "@dex_mod"
          }
        },
        {
          "key": "con",
          "label": "Телосложение (спасбросок)",
          "formulas": {
            "base": "@con_mod"
          }
        },
        {
          "key": "int",
          "label": "Интеллект (спасбросок)",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "wis",
          "label": "Мудрость (спасбросок)",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "cha",
          "label": "Харизма (спасбросок)",
          "formulas": {
            "base": "@cha_mod"
          }
        }
      ],
      "columns": [
        {
          "id": "pl",
          "type": "prof",
          "path": "{key}",
          "label": "Владение",
          "levels": 2
        },
        {
          "id": "base",
          "type": "computed",
          "label": "База",
          "formula": "0"
        },
        {
          "id": "bonus",
          "type": "computed",
          "label": "Бонус",
          "formula": "@base + @pl * @prof",
          "signed": true
        },
        {
          "id": "check",
          "type": "roll",
          "label": "Бросок",
          "roll": "1d20 + @bonus"
        }
      ]
    },
    "skills": {
      "type": "table",
      "path": "skillProf",
      "label": "Навыки",
      "rows": [
        {
          "key": "athletics",
          "label": "Атлетика",
          "formulas": {
            "base": "@str_mod"
          }
        },
        {
          "key": "acrobatics",
          "label": "Акробатика",
          "formulas": {
            "base": "@dex_mod"
          }
        },
        {
          "key": "sleightOfHand",
          "label": "Ловкость рук",
          "formulas": {
            "base": "@dex_mod"
          }
        },
        {
          "key": "stealth",
          "label": "Скрытность",
          "formulas": {
            "base": "@dex_mod"
          }
        },
        {
          "key": "investigation",
          "label": "Анализ",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "history",
          "label": "История",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "arcana",
          "label": "Магия",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "nature",
          "label": "Природа",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "religion",
          "label": "Религия",
          "formulas": {
            "base": "@int_mod"
          }
        },
        {
          "key": "perception",
          "label": "Восприятие",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "survival",
          "label": "Выживание",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "medicine",
          "label": "Медицина",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "insight",
          "label": "Проницательность",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "animalHandling",
          "label": "Уход за животными",
          "formulas": {
            "base": "@wis_mod"
          }
        },
        {
          "key": "performance",
          "label": "Выступление",
          "formulas": {
            "base": "@cha_mod"
          }
        },
        {
          "key": "intimidation",
          "label": "Запугивание",
          "formulas": {
            "base": "@cha_mod"
          }
        },
        {
          "key": "deception",
          "label": "Обман",
          "formulas": {
            "base": "@cha_mod"
          }
        },
        {
          "key": "persuasion",
          "label": "Убеждение",
          "formulas": {
            "base": "@cha_mod"
          }
        }
      ],
      "columns": [
        {
          "id": "pl",
          "type": "prof",
          "path": "{key}",
          "label": "Владение",
          "levels": 3
        },
        {
          "id": "base",
          "type": "computed",
          "label": "База",
          "formula": "0"
        },
        {
          "id": "bonus",
          "type": "computed",
          "label": "Бонус",
          "formula": "@base + @pl * @prof",
          "signed": true
        },
        {
          "id": "check",
          "type": "roll",
          "label": "Бросок",
          "roll": "1d20 + @bonus"
        }
      ]
    },
    "weapons": {
      "type": "table",
      "path": "weapons",
      "label": "Оружие и боевые заговоры",
      "columns": [
        {
          "id": "name",
          "type": "text",
          "path": "name",
          "label": "Название"
        },
        {
          "id": "bonus",
          "type": "text",
          "path": "bonus",
          "label": "Бонус/Сложность",
          "placeholder": "+5",
          "rollable": "check"
        },
        {
          "id": "damage",
          "type": "text",
          "path": "damage",
          "label": "Урон/Вид",
          "rollable": "inline"
        },
        {
          "id": "notes",
          "type": "text",
          "path": "notes",
          "label": "Заметки"
        }
      ]
    },
    "traits": {
      "type": "longtext",
      "path": "traits",
      "label": "Видовые черты"
    },
    "features": {
      "type": "longtext",
      "path": "features",
      "label": "Умения и способности"
    },
    "attacks_spells": {
      "type": "longtext",
      "path": "attacksSpells",
      "label": "Атаки и заклинания"
    },
    "feats": {
