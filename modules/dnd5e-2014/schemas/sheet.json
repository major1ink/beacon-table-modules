      "columns": [
        {
          "id": "slots",
          "type": "pool",
          "path": "{key}",
          "label": "Ячейки"
        }
      ]
    },
    "prepared": {
      "type": "table",
      "path": "preparedSpells",
      "label": "Заговоры и подготовленные заклинания",
      "columns": [
        {
          "id": "level",
          "type": "number",
          "path": "level",
          "label": "Ур."
        },
        {
          "id": "name",
          "type": "text",
