      "label": "Привязанности"
    },
    "flaws": {
      "type": "longtext",
      "path": "flaws",
      "label": "Слабости"
    },
    "goals": {
      "type": "longtext",
      "path": "goals",
      "label": "Цели и задачи"
    },
    "allies": {
      "type": "longtext",
      "path": "allies",
      "label": "Союзники и организации"
    },
    "additional": {
      "type": "longtext",
      "path": "additionalFeatures",
      "label": "Дополнительные способности и умения"
    },
    "treasure": {
      "type": "longtext",
      "path": "treasure",
      "label": "Сокровища"
    },
    "note_0": {
      "type": "longtext",
      "path": "notes.0",
