  "layout": [
    {
      "title": "Основное",
      "fields": [
        "ac_line",
        "hp_line",
        "speed"
      ],
      "mode": "view"
    },
    {
      "title": "Вид",
      "fields": [
        "size",
        "type",
        "alignment"
      ],
      "mode": "edit"
    },
    {
      "title": "Основное",
      "fields": [
        "ac",
        "ac_note",
        "hp",
        "hit_dice",
        "speed"
      ],
      "mode": "edit"
    },
    {
      "title": "Характеристики",
      "cells": [
        [
          "str",
          "str_mod"
        ],
        [
          "dex",
          "dex_mod"
        ],
        [
          "con",
          "con_mod"
        ],
        [
          "int",
          "int_mod"
        ],
        [
          "wis",
          "wis_mod"
        ],
        [
          "cha",
          "cha_mod"
        ]
      ]
    },
    {
      "title": "Защита и чувства",
      "fields": [
        "saving_throws",
        "skills",
        "damage_vulnerabilities",
        "damage_resistances",
        "damage_immunities",
        "condition_immunities",
        "senses",
