        "bonus_actions",
        "reactions",
        "legendary_intro",
        "legendary_actions",
        "lair_actions"
      ]
    },
    {
      "title": "Заклинания",
      "widget": "spells"
    },
    {
      "title": "Добыча",
      "widget": "inventory"
    }
  ],
  "list": {
    "subtitle": "{size} {type} · {alignment} · {cr}",
    "group": "cr",
    "sort": [
      "cr",
      "name"
    ],
    "filters": [
      "cr",
      "type"
    ],
    "search": [
      "name",
      "type",
      "tags"
    ],
    "badges": [
      "cr"
    ],
    "pills": [
      "cr"
    ],
    "medallion": {
      "field": "type",
      "glyph": "hood",
      "colorField": "cr",
      "rules": [
        {
          "contains": [
            "нежить",
            "скелет",
            "зомби",
            "призрак",
            "вампир"
          ],
          "glyph": "skull"
        },
        {
