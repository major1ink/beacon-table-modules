{
  "format": "beacon-schema/v1",
  "kind": "monster",
  "core": {
    "hp.max": "hp",
    "ac": "ac",
    "speed": "speed"
  },
  "fields": {
    "size": {
      "type": "text",
      "path": "size",
      "label": "Размер",
      "placeholder": "Средний",
      "default": "Средний"
    },
    "type": {
      "type": "text",
      "path": "type",
      "label": "Тип",
      "placeholder": "гуманоид",
      "facet": "beforeParen"
    },
    "alignment": {
      "type": "text",
      "path": "alignment",
      "label": "Мировоззрение",
      "placeholder": "нейтральное"
    },
    "ac": {
      "type": "number",
      "path": "ac",
      "label": "Класс доспеха",
      "default": 10
    },
    "ac_note": {
      "type": "text",
      "path": "acNote",
      "label": "Примечание к КД",
      "placeholder": "природный доспех"
    },
    "ac_line": {
      "type": "template",
      "label": "Класс доспеха",
      "template": "{ac}[ ({ac_note})]"
    },
    "hp": {
      "type": "number",
      "path": "hp",
      "label": "Хиты"
    },
    "hit_dice": {
      "type": "text",
      "path": "hitDice",
      "label": "Кость хитов",
      "placeholder": "2к6"
    },
    "hp_line": {
      "type": "template",
      "label": "Хиты",
      "template": "{hp}[ ({hit_dice})]"
    },
    "speed": {
      "type": "text",
      "path": "speed",
      "label": "Скорость",
      "placeholder": "30 фт., полёт 60 фт."
    },
    "str": {
      "type": "number",
      "path": "abilities.str",
      "label": "Сила",
      "short": "Сил",
      "modifierTarget": "abilities.str",
      "default": 10
    },
    "str_mod": {
      "type": "computed",
      "label": "Модификатор: Сила",
      "formula": "floor((@str - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @str_mod"
    },
    "dex": {
      "type": "number",
      "path": "abilities.dex",
      "label": "Ловкость",
      "short": "Лов",
      "modifierTarget": "abilities.dex",
      "default": 10
    },
    "dex_mod": {
      "type": "computed",
      "label": "Модификатор: Ловкость",
      "formula": "floor((@dex - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @dex_mod"
    },
    "con": {
      "type": "number",
      "path": "abilities.con",
      "label": "Телосложение",
      "short": "Тел",
      "modifierTarget": "abilities.con",
      "default": 10
    },
    "con_mod": {
      "type": "computed",
      "label": "Модификатор: Телосложение",
      "formula": "floor((@con - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @con_mod"
    },
    "int": {
      "type": "number",
      "path": "abilities.int",
      "label": "Интеллект",
      "short": "Инт",
      "modifierTarget": "abilities.int",
      "default": 10
    },
    "int_mod": {
      "type": "computed",
      "label": "Модификатор: Интеллект",
      "formula": "floor((@int - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @int_mod"
    },
    "wis": {
      "type": "number",
      "path": "abilities.wis",
      "label": "Мудрость",
      "short": "Мдр",
      "modifierTarget": "abilities.wis",
      "default": 10
    },
    "wis_mod": {
      "type": "computed",
      "label": "Модификатор: Мудрость",
      "formula": "floor((@wis - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @wis_mod"
    },
    "cha": {
      "type": "number",
      "path": "abilities.cha",
      "label": "Харизма",
      "short": "Хар",
      "modifierTarget": "abilities.cha",
      "default": 10
    },
    "cha_mod": {
      "type": "computed",
      "label": "Модификатор: Харизма",
      "formula": "floor((@cha - 10) / 2)",
      "signed": true,
      "roll": "1d20 + @cha_mod"
    },
    "saving_throws": {
      "type": "text",
      "path": "savingThrows",
      "label": "Спасброски",
      "placeholder": "Тел +7, Мдр +4"
    },
    "skills": {
      "type": "text",
      "path": "skills",
      "label": "Навыки",
      "placeholder": "Восприятие +5, Скрытность +6"
    },
    "damage_vulnerabilities": {
      "type": "text",
      "path": "damageVulnerabilities",
      "label": "Уязвимости к урону"
    },
    "damage_resistances": {
      "type": "text",
      "path": "damageResistances",
      "label": "Сопротивления к урону"
    },
    "damage_immunities": {
      "type": "text",
