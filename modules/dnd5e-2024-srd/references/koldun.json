d><td><p style=\"text-align:center\">11</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">8</p></td></tr><tr><td><p style=\"text-align:center\">14</p></td><td><p style=\"text-align:center\">+5</p></td><td><p><strong>Умение подкласса</strong></p></td><td><p style=\"text-align:center\">11</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">8</p></td></tr><tr><td><p style=\"text-align:center\">15</p></td><td><p style=\"text-align:center\">+5</p></td><td><p><a class=\"catalog-ref\" data-kind=\"reference\" data-name=\"Мистический арканум [Mystic Arcanum]\">Мистический арканум</a></p></td><td><p style=\"text-align:center\">12</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">9</p></td></tr><tr><td><p style=\"text-align:center\">16</p></td><td><p style=\"text-align:center\">+5</p></td><td><p><strong>Увеличение характеристик</strong></p></td><td><p style=\"text-align:center\">12</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">9</p></td></tr><tr><td><p style=\"text-align:center\">17</p></td><td><p style=\"text-align:center\">+6</p></td><td><p><a class=\"catalog-ref\" data-kind=\"reference\" data-name=\"Мистический арканум [Mystic Arcanum]\">Мистический арканум</a></p></td><td><p style=\"text-align:center\">14</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">9</p></td></tr><tr><td><p style=\"text-align:center\">18</p></td><td><p style=\"text-align:center\">+6</p></td><td><p>—</p></td><td><p style=\"text-align:center\">14</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">10</p></td></tr><tr><td><p style=\"text-align:center\">19</p></td><td><p style=\"text-align:center\">+6</p></td><td><p><strong>Эпическая черта</strong></p></td><td><p style=\"text-align:center\">15</p></td><td><p style=\"text-align:center\">4</p></td><td><p style=\"text-align:center\">